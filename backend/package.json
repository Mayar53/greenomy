{
  "name": "greenomy-backend",
  "version": "0.1.0",
  "description": "Greenomy REST API — Node.js, Express, PostgreSQL",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node database/migrate.js",
    "seed": "node database/seed.js",
    "db:setup": "npm run migrate && npm run seed",
    "reminders": "node jobs/reminders.js",
    "telegram": "node jobs/telegram.js",
    "test": "node --test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.12.0",
    "sharp": "^0.35.4"
  }
}
