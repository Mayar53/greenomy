# ---------------------------------------------------------------------------
# Greenomy — environment variables
# Copy this file to backend/.env and fill in real values.
# Never commit the actual .env file (it is gitignored).
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500

# Database driver: "pg" (a real server, needs DATABASE_URL) or "pglite"
# (PostgreSQL compiled to WASM, runs in-process, no server to install).
# pglite is for local development and tests only.
DB_DRIVER=pglite
PGLITE_DIR=.pgdata

# Used when DB_DRIVER=pg. Managed providers (Neon/Supabase/RDS): SSL=true.
DATABASE_URL=
DATABASE_SSL=true

# Auth — use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=

# First admin account (signup always creates a plain user, so one admin must be
# seeded via `npm run seed`). Re-seeding promotes the account but never resets
# its password.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Cloud storage (verification photos, partner logos, article images). Optional;
# uploads fall back to the local backend/uploads/ directory.
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Push notifications (Firebase Cloud Messaging). Optional; without it push
# falls back to logging and notifications still land in the database.
PUSH_PROVIDER=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI (optional) — paste a key after AI_API_KEY= to switch the AI features on.
# Works with any OpenAI-compatible endpoint (see docs/DEPLOYMENT.md):
#   OpenAI     AI_API_URL=https://api.openai.com/v1                        AI_MODEL=gpt-4o-mini
#   Gemini     AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.0-flash
#   OpenRouter AI_API_URL=https://openrouter.ai/api/v1                     AI_MODEL=openai/gpt-4o-mini
#   Ollama     AI_API_URL=http://localhost:11434/v1                        AI_MODEL=llama3.2-vision  (any non-empty key)
AI_API_KEY=
AI_API_URL=
AI_MODEL=
AI_FALLBACK_MODELS=
AI_TIMEOUT_MS=120000

# Verification scoring: heuristic (offline, the default) | ai | mock
# Set this to "ai" as well if you want photos scored by the model.
VERIFICATION_PROVIDER=heuristic
AI_VERIFICATION_API_KEY=

# ---------------------------------------------------------------------------
# Email — one provider for everything the app sends: password resets, member
# notifications and daily care reminders.
#
#   MAIL_PROVIDER=console  (default) log the message, delivered nowhere.
#                          The outbox is readable at GET /api/dev/mail in dev.
#   MAIL_PROVIDER=smtp     any SMTP server via an app password. For Gmail:
#                            1. Google Account -> Security -> turn ON
#                               2-Step Verification
#                            2. Security -> App passwords -> create one ("Mail")
#                            3. set MAIL_SMTP_PASS to the 16-character value
#                               (spaces removed), MAIL_SMTP_USER to the address
#   MAIL_PROVIDER=api      a generic HTTP vendor (Resend, SendGrid, Postmark…):
#                          set MAIL_API_URL (the send endpoint) and MAIL_API_KEY.
#
# MAIL_FROM must be a verified/authorised sender; for Gmail its address should
# match MAIL_SMTP_USER.
# ---------------------------------------------------------------------------
MAIL_PROVIDER=smtp
MAIL_FROM=Greenomy <you@example.com>
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_API_URL=
MAIL_API_KEY=

# Email the member when a notification is created (verification, redemption).
# Set to false to keep notifications in-app only.
MAIL_EMAIL_NOTIFICATIONS=true

# Daily care reminders. Run them on a cron with `npm run reminders`, or let the
# API run them itself by setting REMINDERS_ENABLED=true (checked on boot and
# every REMINDERS_INTERVAL_HOURS).
REMINDERS_ENABLED=false
REMINDERS_INTERVAL_HOURS=24

# ---------------------------------------------------------------------------
# Telegram contact bot
#
# 1. In Telegram, message @BotFather, send /newbot and follow the prompts.
# 2. Paste the token it gives you after TELEGRAM_BOT_TOKEN= below.
# 3. Put any long random string after TELEGRAM_WEBHOOK_SECRET= — it becomes part
#    of the webhook URL, so keep it private (e.g. `openssl rand -hex 24`).
# 4. Locally: `npm run telegram` long-polls for messages, so no public URL is
#    needed. On a server: `npm run telegram -- webhook https://your-domain`
#    registers the webhook once, and `npm run telegram -- clear-webhook` undoes it.
#
# The bot replies inside Telegram only; it does not send email. Messages it cannot
# answer are appended to backend/.bot-messages.jsonl — a local record that nobody
# is notified about — and the sender is pointed at the site's email address.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_URL=https://t.me/Greenomy_bot
TELEGRAM_CHANNEL_URL=https://t.me/Greenomy_official

# The public base URL of the site, used in emails (reset and reminder links).
APP_BASE_URL=http://localhost:5173
