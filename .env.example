# ---------------------------------------------------------------------------
# Greenomy — environment variables
# Copy this file to backend/.env and fill in real values.
# Never commit the actual .env file.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgres://user:password@localhost:5432/greenomy
DATABASE_SSL=false

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Cloud storage (verification photos, partner logos, article images)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Push notifications
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI / computer-vision verification provider
AI_VERIFICATION_API_KEY=
