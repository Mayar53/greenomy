# ---------------------------------------------------------------------------
# Greenomy — environment variables
# Copy this file to backend/.env and fill in real values.
# Never commit the actual .env file.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database
# DB_DRIVER=pg       a real PostgreSQL server (production). Needs DATABASE_URL.
# DB_DRIVER=pglite   PostgreSQL compiled to WASM, runs in-process — nothing to
#                    install. Development and tests only (single connection).
DB_DRIVER=pg
PGLITE_DIR=.pgdata

# For DB_DRIVER=pg:
#   Local Docker Compose (docker-compose.yml at the project root):
#     DATABASE_URL=postgres://greenomy:greenomy@localhost:5432/greenomy
#     DATABASE_SSL=false
#   Managed providers (Neon / Supabase / RDS) require TLS:
#     DATABASE_URL=postgres://user:password@host/dbname
#     DATABASE_SSL=true
DATABASE_URL=
DATABASE_SSL=false

# Auth
JWT_SECRET=replace-with-a-long-random-string

# First admin account (signup always creates a plain user, so one admin must
# be seeded). In development these default to admin@greenomy.app / admin12345;
# in production both are required or no admin can exist.
ADMIN_SEED_EMAIL=admin@greenomy.app
ADMIN_SEED_PASSWORD=

# Public base URL, used to build links inside emails (password reset).
APP_BASE_URL=http://localhost:3000

# Transactional email (password reset).
# MAIL_PROVIDER=console  logs the message (development default) and keeps it in
#                        the dev outbox at GET /api/dev/mail
# MAIL_PROVIDER=api      POSTs JSON to MAIL_API_URL with MAIL_API_KEY
#                        (Resend / SendGrid / Postmark / …)
MAIL_PROVIDER=console
MAIL_FROM=
MAIL_API_URL=
MAIL_API_KEY=

# Cloud storage (verification photos, partner logos, article images)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Push notifications
# PUSH_PROVIDER=console  logs deliveries (development default)
# PUSH_PROVIDER=fcm      Firebase Cloud Messaging; requires all three values below
PUSH_PROVIDER=console
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI (optional) — powers AI photo verification, plant identification and the
# gardening assistant. It speaks the OpenAI-compatible chat-completions API, so
# OpenAI, Google (Gemini's compat endpoint), OpenRouter, Groq and a local Ollama
# all work by changing AI_API_URL / AI_MODEL.
# Leave AI_API_KEY empty to run fully offline: no AI features, heuristic scoring.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Comma-separated stand-ins tried when the primary model is overloaded (503).
AI_FALLBACK_MODELS=
AI_TIMEOUT_MS=30000

# Verification scoring: heuristic (offline, the default) | ai | mock
# "ai" requires AI_API_KEY; without it the heuristic scorer is used anyway.
VERIFICATION_PROVIDER=heuristic
AI_VERIFICATION_API_KEY=
