# ---------------------------------------------------------------------------
# Greenomy — environment variables
# Copy this file to backend/.env and fill in real values.
# Never commit the actual .env file.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
# :5173 is `node dev.js`; :5500 is VS Code Live Server.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500

# Database
# DB_DRIVER=pg       a real PostgreSQL server (production). Needs DATABASE_URL.
# DB_DRIVER=pglite   PostgreSQL compiled to WASM, runs in-process — nothing to
#                    install. Development and tests only (single connection).
DB_DRIVER=pg
PGLITE_DIR=.pgdata

# For DB_DRIVER=pg:
#   Local Docker Compose (docker-compose.yml at the project root):
#     DATABASE_URL=postgres://greenomy:greenomy@localhost:5432/greenomy
#     DATABASE_SSL=false
#   Managed providers (Neon / Supabase / RDS) require TLS:
#     DATABASE_URL=postgres://user:password@host/dbname
#     DATABASE_SSL=true
DATABASE_URL=
DATABASE_SSL=false

# Auth
JWT_SECRET=replace-with-a-long-random-string

# The OWNER account — the one account that can add admins. Signup always creates
# a plain user, so one owner must be seeded. In development this defaults to
# mayarraws@gmail.com with the password below; in production both are required or
# nobody can administer the site.
#
# This is the login account, not the public contact address. That one is on the
# contact page and in MAIL_FROM (see below).
ADMIN_SEED_EMAIL=mayarraws@gmail.com
ADMIN_SEED_PASSWORD=

# Public base URL, used to build links inside emails (password reset).
APP_BASE_URL=http://localhost:3000

# Transactional email (password reset).
# MAIL_PROVIDER=console  logs the message (development default) and keeps it in
#                        the dev outbox at GET /api/dev/mail
# MAIL_PROVIDER=api      POSTs JSON to MAIL_API_URL with MAIL_API_KEY
#                        (Resend / SendGrid / Postmark / …)
MAIL_PROVIDER=console
# The site's own address, shown on the contact page and used as the From header
# of outgoing mail (password resets).
MAIL_FROM=Greenomy <Greenomyofficial@gmail.com>
MAIL_API_URL=
MAIL_API_KEY=

# Verification images — the ORIGINAL bytes are written to IMAGE_STORAGE_DIR
# (content-addressed by SHA-256, so identical bytes never make a second file)
# and the database keeps only a small preview. Duplicate detection compares
# hashes across every user's submissions.
IMAGE_STORAGE_DIR=uploads
IMAGE_MAX_BYTES=8388608
# Hamming distance still counted as a near-duplicate (0 = exact bytes only).
IMAGE_PHASH_DISTANCE=4
# How many recent images the near-duplicate scan compares against.
IMAGE_DUPLICATE_SCAN_LIMIT=2000

# Verification challenge: the code a reward-eligible photo must show.
CHALLENGE_TTL_MS=1800000
CHALLENGE_LENGTH=4

# Reward engine — points per verified outcome. A single photo only ever pays the
# milestone it evidences; the completion bonus is separate and only after every
# milestone of the journey is done. All awards are idempotent.
REWARD_PHOTO_POINTS=30
REWARD_PLANTING_POINTS=20
REWARD_GROWTH_POINTS=40
REWARD_JOURNEY_COMPLETE_POINTS=100

# Push notifications
# PUSH_PROVIDER=console  logs deliveries (development default)
# PUSH_PROVIDER=fcm      Firebase Cloud Messaging; requires all three values below
PUSH_PROVIDER=console
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Weather for plant recommendations: open-meteo (default, keyless) | offline
# Offline uses a built-in climate table and makes no network calls at all.
# NOTE: Open-Meteo's free tier is non-commercial only — see docs/DEPLOYMENT.md
# before launch. WEATHER_API_KEY switches to their commercial customer- host.
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_BASE_URL=
WEATHER_CACHE_TTL_MS=3600000
WEATHER_TIMEOUT_MS=8000

# AI (optional) — powers AI photo verification, plant identification and the
# gardening assistant. It speaks the OpenAI-compatible chat-completions API, so
# OpenAI, Google (Gemini's compat endpoint), OpenRouter, Groq and a local Ollama
# all work by changing AI_API_URL / AI_MODEL.
# Leave AI_API_KEY empty to run fully offline: no AI features, heuristic scoring.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Comma-separated stand-ins tried when the primary model is overloaded (503).
AI_FALLBACK_MODELS=
AI_TIMEOUT_MS=30000
# Assistant conversation memory: how many earlier turns to replay with each new
# question (0 disables it), and the per-minute burst cap on AI calls. Neither is
# a "number of questions" limit — a conversation may continue freely within them.
AI_MAX_HISTORY=8
AI_RATE_LIMIT_PER_MIN=12

# Verification scoring: heuristic (offline, the default) | ai | mock
# "ai" requires AI_API_KEY; without it the heuristic scorer is used anyway.
VERIFICATION_PROVIDER=heuristic
AI_VERIFICATION_API_KEY=

# Verification thresholds. The two green ratios are a fallback plant check used
# only when no vision model is configured; with a model, its plant verdict is
# what counts. See services/provenance.service.js for the originality signals.
VERIFY_MIN_GREEN_RATIO=0.1
VERIFY_STRONG_GREEN_RATIO=0.25
# An image smaller than this on its shortest edge is held for review.
PROVENANCE_MIN_DIMENSION=240
# Luminance variance below which a top/bottom band counts as "flat UI bar".
PROVENANCE_BAND_FLAT=12
