# ---------------------------------------------------------------------------
# Greenomy — environment variables
#
# The one env file for the whole backend. Copy it into place and fill in real
# values:
#     cd backend && cp ../.env.example .env
# Never commit the actual .env (it is gitignored).
#
# The values below are the ones you are expected to choose. Every other knob
# (duplicate-scan limits, provenance thresholds, …) has a safe default in the
# code — grep for `process.env.` under backend/ to see them all.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
# :5173 is `node dev.js`; :5500 is VS Code Live Server.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500

# Database
# DB_DRIVER=pg       a real PostgreSQL server (production). Needs DATABASE_URL.
# DB_DRIVER=pglite   PostgreSQL compiled to WASM, runs in-process — nothing to
#                    install. Development and tests only (single connection).
DB_DRIVER=pg
PGLITE_DIR=.pgdata

# For DB_DRIVER=pg:
#   Local Docker Compose (docker-compose.yml at the project root):
#     DATABASE_URL=postgres://greenomy:greenomy@localhost:5432/greenomy
#     DATABASE_SSL=false
#   Managed providers (Neon / Supabase / RDS) require TLS:
#     DATABASE_URL=postgres://user:password@host/dbname
#     DATABASE_SSL=true
DATABASE_URL=
DATABASE_SSL=false
# Connection pool size (DB_DRIVER=pg only).
DB_POOL_MAX=10

# Auth
JWT_SECRET=replace-with-a-long-random-string

# The OWNER account — the one account that can add admins. Signup always creates
# a plain user, so one owner must be seeded. In development this defaults to
# mayarraws@gmail.com with the password below; in production both are required or
# nobody can administer the site.
#
# This is the login account, not the public contact address. That one is on the
# contact page and in MAIL_FROM (see below).
ADMIN_SEED_EMAIL=mayarraws@gmail.com
ADMIN_SEED_PASSWORD=

# Public base URL, used to build links inside emails (password reset, care
# reminders, notifications). It must be the address the member actually opens,
# or the link lands nowhere:
#   :5173  `node dev.js` (the usual local one)
#   :5500  VS Code Live Server
#   the real domain in production.
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Email — ONE provider for everything the app sends: password resets, member
# notifications and daily care reminders.
#
#   MAIL_PROVIDER=console  (default) log the message, delivered nowhere.
#                          The outbox is readable at GET /api/dev/mail in dev.
#   MAIL_PROVIDER=smtp     any SMTP server via an app password. For Gmail:
#                            1. Google Account -> Security -> turn ON
#                               2-Step Verification
#                            2. Security -> App passwords -> create one ("Mail")
#                            3. set MAIL_SMTP_PASS to the 16-character value
#                               (spaces removed), MAIL_SMTP_USER to the address
#   MAIL_PROVIDER=api      a generic HTTP vendor (Resend, SendGrid, Postmark…):
#                          set MAIL_API_URL (the send endpoint) and MAIL_API_KEY.
#
# MAIL_FROM is the From header and the site's public contact address. It must be
# a verified/authorised sender; for Gmail its address should match MAIL_SMTP_USER.
# ---------------------------------------------------------------------------
MAIL_PROVIDER=console
MAIL_FROM=Greenomy <Greenomyofficial@gmail.com>
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_API_URL=
MAIL_API_KEY=

# Email the member when a notification is created (verification, redemption).
# Set to false to keep notifications in-app only.
MAIL_EMAIL_NOTIFICATIONS=true

# Daily care reminders. Run them on a cron with `npm run reminders`, or let the
# API run them itself by setting REMINDERS_ENABLED=true (checked on boot and
# every REMINDERS_INTERVAL_HOURS).
REMINDERS_ENABLED=false
REMINDERS_INTERVAL_HOURS=24

# Verification images — the ORIGINAL bytes are written to IMAGE_STORAGE_DIR
# (content-addressed by SHA-256, so identical bytes never make a second file)
# and the database keeps only a small preview. Duplicate detection compares
# hashes across every user's submissions.
IMAGE_STORAGE_DIR=uploads
IMAGE_MAX_BYTES=8388608
# Hamming distance still counted as a near-duplicate (0 = exact bytes only).
IMAGE_PHASH_DISTANCE=4
# How many recent images the near-duplicate scan compares against.
IMAGE_DUPLICATE_SCAN_LIMIT=2000

# Verification challenge: the code a reward-eligible photo must show.
CHALLENGE_TTL_MS=1800000
CHALLENGE_LENGTH=4

# Reward engine — points per verified outcome. A single photo only ever pays the
# milestone it evidences; the completion bonus is separate and only after every
# milestone of the journey is done. All awards are idempotent.
REWARD_PHOTO_POINTS=30
REWARD_PLANTING_POINTS=20
REWARD_GROWTH_POINTS=40
REWARD_JOURNEY_COMPLETE_POINTS=100

# Push notifications
# PUSH_PROVIDER=console  logs deliveries (development default)
# PUSH_PROVIDER=fcm      Firebase Cloud Messaging; requires all three values below
PUSH_PROVIDER=console
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Weather for plant recommendations: offline (default) | open-meteo
# Offline uses a built-in climate table and makes no network calls at all.
# Open-Meteo is opt-in; its free tier is non-commercial only — see
# docs/DEPLOYMENT.md. WEATHER_API_KEY switches to their commercial customer- host.
WEATHER_PROVIDER=offline
WEATHER_API_KEY=
WEATHER_BASE_URL=
WEATHER_GEOCODE_URL=
WEATHER_CACHE_TTL_MS=3600000
WEATHER_TIMEOUT_MS=8000

# AI (optional) — powers AI photo verification, plant identification and the
# gardening assistant. It speaks the OpenAI-compatible chat-completions API, so
# OpenAI, Google (Gemini's compat endpoint), OpenRouter, Groq and a local Ollama
# all work by changing AI_API_URL / AI_MODEL.
# Leave AI_API_KEY empty to run fully offline: no AI features, heuristic scoring.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Comma-separated stand-ins tried when the primary model is overloaded (503).
AI_FALLBACK_MODELS=
AI_TIMEOUT_MS=30000
# Attempts per call before the AI features give up and fall back.
AI_MAX_ATTEMPTS=3
# Assistant conversation memory: how many earlier turns to replay with each new
# question (0 disables it), and the per-minute burst cap on AI calls. Neither is
# a "number of questions" limit — a conversation may continue freely within them.
AI_MAX_HISTORY=8
AI_RATE_LIMIT_PER_MIN=12

# Verification scoring: heuristic (offline, the default) | ai | mock
# "ai" requires AI_API_KEY; without it the heuristic scorer is used anyway.
VERIFICATION_PROVIDER=heuristic
AI_VERIFICATION_API_KEY=

# Verification thresholds. The two green ratios are a fallback plant check used
# only when no vision model is configured; with a model, its plant verdict is
# what counts. See services/provenance.service.js for the originality signals.
VERIFY_MIN_GREEN_RATIO=0.1
VERIFY_STRONG_GREEN_RATIO=0.25
# Per-minute caps on photo submissions and challenge requests.
VERIFY_SUBMIT_MAX=20
VERIFY_CHALLENGE_MAX=40
# An image smaller than this on its shortest edge is held for review.
PROVENANCE_MIN_DIMENSION=240
# Luminance variance below which a top/bottom band counts as "flat UI bar".
PROVENANCE_BAND_FLAT=12

# ---------------------------------------------------------------------------
# Telegram contact bot
#
# 1. In Telegram, message @BotFather, send /newbot and follow the prompts.
# 2. Paste the token it gives you after TELEGRAM_BOT_TOKEN= below.
# 3. Put any long random string after TELEGRAM_WEBHOOK_SECRET= — it becomes part
#    of the webhook URL, so keep it private (e.g. `openssl rand -hex 24`).
# 4. Locally: `npm run telegram` long-polls for messages, so no public URL is
#    needed. On a server: `npm run telegram -- webhook https://your-domain`
#    registers the webhook once, and `npm run telegram -- clear-webhook` undoes it.
#
# The bot replies inside Telegram only; it does not send email. Messages it cannot
# answer are appended to backend/.bot-messages.jsonl — a local record that nobody
# is notified about — and the sender is pointed at the site's email address.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_URL=https://t.me/Greenomy_bot
TELEGRAM_CHANNEL_URL=https://t.me/Greenomy_official
