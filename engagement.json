  "facts": [
    {
      "id": "fact-flowering-plants",
      "icon": "spark",
      "title": "Why plants flower",
      "body": "Flowering is a plant's signal that it has enough light and energy to reproduce. Your first flower means the plant is thriving, not just surviving.",
      "i18n": {
        "ar": {
          "title": "لماذا تُزهر النباتات",
          "body": "الإزهار إشارة إلى أن النبات حصل على ضوء وطاقة كافيين للتكاثر. أول زهرة تعني أن نباتك مزدهر وليس فقط ناجياً."
        },
        "ku": {
          "title": "بۆچی ڕووەکەکان گەشە دەکەن",
          "body": "گەشەکردن ئاماژەیە بۆ ئەوەی ڕووەک ڕووناکی و وزەی پێویست هەیە بۆ زاوزێکردن. یەکەم گوڵ واتە ڕووەکەکەت گەشە دەکات نەک تەنها دەژیت."
        }
      }
    },
    {
      "id": "fact-perennials",
      "icon": "recycle",
      "title": "Perennials come back",
      "body": "Perennial herbs and trees die back in winter and regrow from the same roots. Mark where they are planted so you don't disturb them while digging.",
      "i18n": {
        "ar": {
          "title": "النباتات المعمّرة تعود",
          "body": "الأعشاب والأشجار المعمّرة تذبل شتاءً وتنمو مجدداً من الجذور نفسها. علّم مكان زراعتها كي لا تزعجها أثناء الحفر."
        },
        "ku": {
          "title": "ڕووەکە چەندساڵەکان دەگەڕێنەوە",
          "body": "ڕووەک و درەختە چەندساڵەکان لە زستان دەمرن و لە هەمان ڕەگدا دووبارە گەشە دەکەن. شوێنی چاندنیان دیاری بکە بۆ ئەوەی لە کاتی هەڵکۆڵین تێکیان نەدەیت."
        }
      }
    },
    {
      "id": "fact-harvest-seed-saving",
      "icon": "book",
      "title": "Save your own seed",
      "body": "Let one healthy plant go to seed and you will never need to buy it again. Dry the seed fully before storing it in a cool, dark jar.",
      "i18n": {
        "ar": {
          "title": "احفظ بذورك",
          "body": "اترك نباتاً سليماً واحداً ليُنتج البذور ولن تحتاج لشرائها مجدداً. جفف البذور تماماً قبل حفظها في برطمان بارد ومظلم."
        },
        "ku": {
          "title": "تۆوی خۆت بپارێزە",
          "body": "یەک ڕووەکی تەندروست بهێڵە بۆ تۆو و هەرگیز پێویستت بە کڕینەوە نابێت. تۆوەکە بە تەواوی وشک بکەرەوە پێش هەڵگرتنی لە قاپێکی سارد و تاریک."
        }
      }
    },
    {
      "id": "fact-root-depth",
      "icon": "root",
      "title": "Roots go deeper than you think",
      "body": "Many vegetables send roots down twice as wide as the plant is tall. That is why deep, loose soil beats a shallow pot with frequent watering.",
      "i18n": {
        "ar": {
          "title": "الجذور أعمق مما تظن",
          "body": "تمتد جذور كثير من الخضروات بعرض ضعف ارتفاع النبات. لهذا التربة العميقة الرخوة أفضل من وعاء ضحل مع سقي متكرر."
        },
        "ku": {
          "title": "ڕەگەکان قوڵترن لەوەی بیربکەیتەوە",
          "body": "زۆرێک لە سەوزەوات ڕەگەکانیان دوو ئەوەندەی بەرزی ڕووەکەکە درێژ دەکەن. بۆیە خاکی قوڵ و نەرم باشترە لە قاپێکی کەم قوڵ بە ئاودانی زۆر."
        }
      }
    },
    {
      "id": "fact-legume-nitrogen",
      "icon": "compost",
      "title": "Legumes feed the soil",
      "body": "Beans and peas work with bacteria in their roots to pull nitrogen from the air. Planting them before a leafy crop leaves the soil richer.",
      "i18n": {
        "ar": {
          "title": "البقوليات تغذي التربة",
          "body": "تعمل الفاصولياء والبازلاء مع بكتيريا الجذور لسحب النيتروجين من الهواء. زراعتها قبل محصول ورقي تُغني التربة."
        },
        "ku": {
          "title": "باقیلاتەکان خاک دەوڵەمەند دەکەن",
          "body": "فاسۆلیا و نۆک لەگەڵ بەکتریای ڕەگدا کار دەکەن بۆ کێشانی نایترۆجین لە هەوا. چاندنیان پێش بەرهەمێکی گەڵا خاک دەوڵەمەندتر دەکات."
        }
      }
    },
    {
      "id": "fact-succulent-water",
      "icon": "droplet",
      "title": "Succulents store water",
      "body": "Thick leaves are water tanks. A succulent that looks slightly soft is often healthier than one you water every day — let the soil dry out fully first.",
      "i18n": {
        "ar": {
          "title": "النباتات العصارية تخزن الماء",
          "body": "الأوراق السميكة خزانات ماء. النبات العصاري الذي يبدو ناعماً قليلاً غالباً أكثر صحة من الذي تسقيه يومياً — دع التربة تجف تماماً أولاً."
        },
        "ku": {
          "title": "ڕووەکە ئاویەکان ئاو هەڵدەگرن",
          "body": "گەڵای ئەستوور تانکی ئاون. ڕووەکێکی ئاوی کە کەمێک نەرم دیارە زۆرجار تەندروستترە لەوەی ڕۆژانە ئاوی دەدەیتێ — سەرەتا ڕێگە بە خاکەکە بدە بە تەواوی وشک بێت."
        }
      }
    },
    {
      "id": "fact-tomato-roots",
      "icon": "fruit",
      "title": "{plant} stems can reroot",
      "body": "Bury a leggy {plant} seedling deeper than it was growing and tiny hairs on the stem will turn into new roots, giving you a stronger plant.",
      "i18n": {
        "ar": {
          "title": "ساق {plant} يمكن أن تتجذر",
          "body": "ادفن شتلة {plant} الأطول أعمق مما كانت تنمو وستتحول الشعيرات الدقيقة على الساق إلى جذور جديدة، لتحصل على نبات أقوى."
        },
        "ku": {
          "title": "قەدی {plant} دەتوانێت دووبارە ڕەگ بدات",
          "body": "شیتلەی {plant}ی درێژ قوڵتر بڕوێنە لەوەی گەشەی دەکرد، مووە وردەکانی قەدەکە دەبنە ڕەگی نوێ و ڕووەکێکی بەهێزترت پێدەدات."
        }
      },
      "plantId": "pl-tomato"
    },
    {
      "id": "fact-rare-variegation",
      "icon": "leaf",
      "title": "Variegation is a mutation",
      "description": "A rare plant fact.",
      "body": "White or pink patches on a leaf are cells that lost their green pigment. Keep a variegated plant in bright, indirect light — the pale parts cannot photosynthesise as well.",
      "i18n": {
        "ar": {
          "title": "التبرقش طفرة",
          "body": "البقع البيضاء أو الوردية على الورقة خلايا فقدت صبغتها الخضراء. ضع النبات المبرقش في ضوء ساطع غير مباشر — الأجزاء الفاتحة لا تقوم بالبناء الضوئي بكفاءة."
        },
        "ku": {
          "title": "ڕەنگاویشی گۆڕانکارییەکی بۆماوەییە",
          "body": "خاڵە سپی یان پەمەییەکانی سەر گەڵا خانەن کە ڕەنگی سەوزیان لەدەستداوە. ڕووەکە ڕەنگاوڕەنگەکە لە ڕووناکی ڕوون و ناڕاستەوخۆ دابنێ — بەشە کاڵەکان ناتوانن باش فۆتۆسینتێز بکەن."
        }
      }
    }
  ],
