# Node
node_modules/
npm-debug.log*

# Environment (keep .env.example)
.env
.env.local
backend/.env

# Local database created by the PGlite dev driver
.pgdata/
backend/.pgdata/
# Kept when a database has to be re-initialised: unreadable, but not thrown away.
backend/.pgdata.broken/

# Verification images written by the API (content-addressed, never committed)
backend/uploads/

# Runtime state of the Telegram contact bot (which chat chose which language,
# and the log of messages it could not answer)
backend/.bot-state.json
backend/.bot-messages.jsonl

# Local agent scratch (Command Code taste/preferences), never part of the app
.commandcode/

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
